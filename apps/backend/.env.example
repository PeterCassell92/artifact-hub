# Copy to .env (git-ignored) for local dev.

# ── Database ──
# Prisma reads ONLY this (no separate POSTGRES_* vars here). The user:password@host:port/db must
# match the root .env's POSTGRES_* (which docker-compose uses to create the DB). Defaults align.
# Port is 5440 — the host port docker-compose maps Postgres to (avoids clashing with a local 5432).
DATABASE_URL="postgresql://artifacthub:artifacthub@localhost:5440/artifacthub?schema=public"

# ── Server ──
# 3081 for local dev — avoids clashing with anything already on :3000. Prod pins this in fly.toml.
PORT=3081

# ── Initial admins (comma-separated) — seeded idempotently (docs/architecture/02 §5) ──
INITIAL_ADMIN_EMAILS="you@example.com"

# ── Public app origin — builds share-link (03 §5) and invitation-accept (02 §4) URLs ──
# Defaults to the Vite dev server port; prod sets the real Netlify domain via fly secrets.
APP_ORIGIN="http://localhost:5173"

# ── Auth0 (Role A app login + Role B MCP resource server) ──
# The backend is a token-VALIDATING resource server here — it needs the domain + audiences, NOT a
# client_id. The SPA's client_id lives in apps/frontend/.env (VITE_AUTH0_CLIENT_ID); MCP clients
# self-register via DCR. See docs/architecture/02 §1.
AUTH0_DOMAIN="your-tenant.eu.auth0.com"
AUTH0_API_AUDIENCE="https://api.artifact-hub.example"   # /api/* tokens
AUTH0_MCP_AUDIENCE="https://mcp.artifact-hub.example"   # /mcp tokens (audience-bound, R2)

# ── Auth0 Management API (M2M) — invitation provisioning ONLY (docs/architecture/02 §4/§6) ──
# Needed only once the invitation flow creates Auth0 users at invite-accept. Leave unset to run
# login-only locally (seeded users can sign in without it). Create a SEPARATE Auth0 "Machine to
# Machine" application (NOT the SPA) authorized for the Auth0 Management API, then paste its creds.
# Prod: set as `fly secrets`, never commit real values.
# AUTH0_MGMT_CLIENT_ID="your-m2m-client-id"
# AUTH0_MGMT_CLIENT_SECRET="your-m2m-client-secret"

# ── Email: SMTP everywhere. Dev → MailCatcher (no auth). Prod → Resend (auth via fly secrets). ──
# (docs/development/email-catcher.md). The magic-link email is Auth0's; this is only for invitations.
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM="Artifact Hub <no-reply@artifact-hub.local>"
# Prod (Resend) — set these as fly secrets, do not commit real values:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=resend
#   SMTP_PASS=<RESEND_API_KEY>
#   EMAIL_FROM="Artifact Hub <no-reply@yourdomain>"   # Resend-verified domain

# ── Transactional outbox drain loop (docs/architecture/02 §6) — in-process poller, no extra infra ──
OUTBOX_POLL_INTERVAL_MS=3000

# ── Object storage: S3-compatible (MinIO in dev, Tigris in prod) ──
# NOT AWS. The AWS_* names are just the AWS SDK v3's standard S3 credential/endpoint vars, which any
# S3-compatible store reuses — the endpoint is what selects the provider. Prod values are injected by
# `fly storage create`; dev values below match docker-compose's minio + createbuckets services.
BUCKET_NAME="artifact-hub-dev"
AWS_ENDPOINT_URL_S3="http://localhost:9000"   # dev MinIO; prod: https://fly.storage.tigris.dev
AWS_REGION="auto"                             # Tigris convention; MinIO ignores it
AWS_ACCESS_KEY_ID="dev-access-key"            # = MinIO root user (docker-compose)
AWS_SECRET_ACCESS_KEY="dev-secret-key"        # = MinIO root password (docker-compose)

# ── AWS Bedrock — artifact enrichment (docs/architecture/01 decision #46) ──
# A Bedrock API key (bearer token), NOT an IAM access key/secret pair, and a SEPARATE credential
# from AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY above, which point at MinIO/Tigris, not real AWS.
# Optional — the backend boots and the outbox drain loop runs fine without it; unconfigured
# enrichment jobs just fail (retried, then marked `failed`) rather than blocking anything else.
# Model id and thresholds are NOT here — see src/config.ts (git-committed tunables, not secrets).
# Prod: set as `fly secrets`, never commit real values.
# These keys EXPIRE (AWS Bedrock API keys are short- or long-term, never indefinite) — rotate
# before they lapse, unlike a typical IAM access key.
# BEDROCK_API_KEY="your-bedrock-api-key"
# BEDROCK_AWS_REGION="us-east-1"

# ── Dev/test-only auth shortcut (docs/development/bruno-mcp-token.md) ──
# Required outside production (see env.ts). NEVER set/used in production — the RS validator only
# trusts real Auth0 JWKS there. Generate with e.g. `openssl rand -hex 32`.
TEST_JWT_SIGNING_SECRET="replace-with-a-long-random-dev-only-secret"
# Shared secret gating POST /test/mcp-token (sent as the X-Test-Token header).
TEST_MINT_SECRET="replace-with-a-long-random-dev-only-secret"
