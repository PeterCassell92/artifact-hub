# Copy to .env (git-ignored) for local dev.

# ── Database ──
# Prisma reads ONLY this (no separate POSTGRES_* vars here). The user:password@host:port/db must
# match the root .env's POSTGRES_* (which docker-compose uses to create the DB). Defaults align.
# Port is 5440 — the host port docker-compose maps Postgres to (avoids clashing with a local 5432).
DATABASE_URL="postgresql://artifacthub:artifacthub@localhost:5440/artifacthub?schema=public"

# ── Server ──
# 3081 for local dev — avoids clashing with anything already on :3000. Prod pins this in fly.toml.
PORT=3081

# ── Initial admins (comma-separated) — seeded idempotently (docs/architecture/02 §5) ──
INITIAL_ADMIN_EMAILS="you@example.com"

# ── Auth0 (Role A app login + Role B MCP resource server) ──
AUTH0_DOMAIN="your-tenant.eu.auth0.com"
AUTH0_API_AUDIENCE="https://api.artifact-hub.example"   # /api/* tokens
AUTH0_MCP_AUDIENCE="https://mcp.artifact-hub.example"   # /mcp tokens (audience-bound, R2)

# ── Email: SMTP everywhere. Dev → MailCatcher (no auth). Prod → Resend (auth via fly secrets). ──
# (docs/development/email-catcher.md). The magic-link email is Auth0's; this is only for invitations.
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM="Artifact Hub <no-reply@artifact-hub.local>"
# Prod (Resend) — set these as fly secrets, do not commit real values:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=resend
#   SMTP_PASS=<RESEND_API_KEY>
#   EMAIL_FROM="Artifact Hub <no-reply@yourdomain>"   # Resend-verified domain

# ── Object storage: S3-compatible (MinIO in dev, Tigris in prod) ──
# NOT AWS. The AWS_* names are just the AWS SDK v3's standard S3 credential/endpoint vars, which any
# S3-compatible store reuses — the endpoint is what selects the provider. Prod values are injected by
# `fly storage create`; dev values below match docker-compose's minio + createbuckets services.
BUCKET_NAME="artifact-hub-dev"
AWS_ENDPOINT_URL_S3="http://localhost:9000"   # dev MinIO; prod: https://fly.storage.tigris.dev
AWS_REGION="auto"                             # Tigris convention; MinIO ignores it
AWS_ACCESS_KEY_ID="dev-access-key"            # = MinIO root user (docker-compose)
AWS_SECRET_ACCESS_KEY="dev-secret-key"        # = MinIO root password (docker-compose)
