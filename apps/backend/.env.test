# Loaded by jest.setup.ts for every backend test run. Dummy/non-secret values only — safe to
# commit (see .gitignore's `!**/.env.test` exception). DATABASE_URL is a placeholder; *.int.test.ts
# files overwrite process.env.DATABASE_URL with the Testcontainers connection string before the app
# is (dynamically) imported — see src/test-support/testDatabase.ts.

DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder"
PORT=3081

INITIAL_ADMIN_EMAILS=""

APP_ORIGIN="https://artifact-hub.test"

AUTH0_DOMAIN="test.auth0.local"
AUTH0_API_AUDIENCE="https://api.artifact-hub.test"
AUTH0_MCP_AUDIENCE="https://mcp.artifact-hub.test"
AUTH0_MGMT_CLIENT_ID="test-mgmt-client-id"
AUTH0_MGMT_CLIENT_SECRET="test-mgmt-client-secret"

EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM="Artifact Hub Test <no-reply@artifact-hub.local>"

# Unlike DATABASE_URL, there's no Testcontainers swap for S3 — these must be the REAL local
# docker-compose MinIO creds/bucket (same as apps/backend/.env.example) so storage-touching tests
# (MCP publish/finalize/resource-read) hit an object store that actually exists, exactly like
# EMAIL_TRANSPORT/SMTP_* above point at the real local MailCatcher rather than a placeholder.
BUCKET_NAME="artifact-hub-dev"
AWS_ENDPOINT_URL_S3="http://localhost:9000"
AWS_REGION="auto"
AWS_ACCESS_KEY_ID="dev-access-key"
AWS_SECRET_ACCESS_KEY="dev-secret-key"

TEST_JWT_SIGNING_SECRET="test-only-dev-jwt-signing-secret-not-for-prod-use"
TEST_MINT_SECRET="test-only-dev-mint-secret-not-for-prod-use"
