# Loaded by jest.setup.ts for every backend test run. Dummy/non-secret values only — safe to
# commit (see .gitignore's `!**/.env.test` exception). DATABASE_URL is a placeholder; *.int.test.ts
# files overwrite process.env.DATABASE_URL with the Testcontainers connection string before the app
# is (dynamically) imported — see src/test-support/testDatabase.ts.

DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder"
PORT=3081

INITIAL_ADMIN_EMAILS=""

AUTH0_DOMAIN="test.auth0.local"
AUTH0_API_AUDIENCE="https://api.artifact-hub.test"
AUTH0_MCP_AUDIENCE="https://mcp.artifact-hub.test"

EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM="Artifact Hub Test <no-reply@artifact-hub.local>"

BUCKET_NAME="artifact-hub-test"
AWS_ENDPOINT_URL_S3="http://localhost:9000"
AWS_REGION="auto"
AWS_ACCESS_KEY_ID="test-access-key"
AWS_SECRET_ACCESS_KEY="test-secret-key"

DEV_JWT_SIGNING_SECRET="test-only-dev-jwt-signing-secret-not-for-prod-use"
DEV_MINT_SECRET="test-only-dev-mint-secret-not-for-prod-use"
