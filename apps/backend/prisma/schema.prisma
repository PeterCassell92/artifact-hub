// Artifact Hub — Prisma schema
//
// Source of truth for these models is docs/models/ (field-level definitions) and
// docs/architecture/04-data-model.md (ERD + rationale). Keep them in sync.
//
// Conventions: opaque UUID ids; UTC timestamps; no artifact edit/delete in v1;
// passwordless auth (no password field); one access policy per artifact.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── enums ───────────────────────────

enum Role {
  member
  admin
}

enum UserStatus {
  invited
  active
  disabled
}

enum AudienceType {
  public_authenticated
  specific_users
  user_groups
}

enum InviteStatus {
  pending
  accepted
  expired
  revoked
}

enum RelationType {
  supersedes
  derived_from
  related_to
}

enum ArtifactKind {
  diagram
  document
  image
  report
  data
  other
}

enum AccessRoute {
  ui
  share_link
  mcp
  system
}

enum EnrichmentStatus {
  pending
  running
  completed
  failed
  skipped
}

enum EnrichmentSource {
  human
  ai
}

enum AccessAction {
  view
  download
}

enum AccessDecision {
  allowed
  denied
}

// ─────────────────────────── identity ───────────────────────────

model User {
  id        String     @id @default(uuid())
  idpSub    String?    @unique // Auth0 subject; null until first magic-link sign-in
  email     String     @unique
  name      String // every user must have a display name — set by the admin at invite time
  avatarUrl String?
  role      Role       @default(member)
  status    UserStatus @default(invited)
  createdAt DateTime   @default(now())

  memberships          GroupMembership[]
  artifacts            Artifact[]             @relation("owner")
  comments             Comment[]
  allowedFor           ArtifactAllowedUser[]
  shareLinks           ShareLink[]
  invitesSent          Invitation[]           @relation("invitedBy")
  accessEvents         AccessEvent[]
  createdRelationships ArtifactRelationship[]
  requestedEnrichments ArtifactEnrichment[]
}

model Group {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  memberships GroupMembership[]
  allowedFor  ArtifactAllowedGroup[]
}

// Admin-assigned at invite time; immutable by the user (enforced in the service layer).
model GroupMembership {
  userId  String
  groupId String
  addedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@id([userId, groupId])
}

model Invitation {
  id          String       @id @default(uuid())
  email       String
  name        String? // admin-provided display name, applied to the user record at invite time
  role        Role         @default(member)
  groupIds    String[] // groups to assign on accept (immutable thereafter)
  tokenHash   String       @unique // sha-256 of the emailed token; raw token only in the link
  status      InviteStatus @default(pending)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime     @default(now())

  invitedBy User @relation("invitedBy", fields: [invitedById], references: [id])

  @@index([email])
}

// ─────────────────────────── artifacts ───────────────────────────

model Artifact {
  id             String  @id @default(uuid())
  ownerId        String
  title          String
  description    String?
  fileName       String
  contentType    String // MIME
  storageKey     String  @unique // object key in the Tigris (S3-compatible) bucket
  sizeBytes      BigInt
  checksumSha256 String?

  // classification metadata (drives frontend filters; see docs/models/artifact.md)
  kind           ArtifactKind @default(other)
  sourceTool     String? // e.g. "Claude Desktop"
  sourcePlatform String?
  language       String?
  metadata       Json         @default("{}") // free-form catch-all

  // AI-generated enrichment output (see ArtifactEnrichment for the job/run history that produced
  // these) — first-class columns rather than buried in `metadata` so they're easy to display/filter.
  aiSummary String?
  aiTopics  String[] @default([])

  // access policy (one per artifact — see docs/architecture/03)
  audienceType      AudienceType @default(specific_users)
  expiresAt         DateTime? // null = never
  // Owner-initiated instant cutoff, independent of expiresAt (03 §1a) — distinct from a bucketed
  // expiry naturally elapsing so the UI can tell "you revoked this" apart from "its window ran
  // out on its own". Saving a new policy (PUT/set_access_policy) always clears this back to false.
  revoked           Boolean      @default(false)
  policyUpdatedAt   DateTime     @default(now())
  policyUpdatedById String? // owner who last changed the policy

  createdAt DateTime @default(now())

  // Denormalized from AccessEvent (max allowed view/download `at`) so `sort=lastAccessed`
  // (docs/frontend/02 §3) can be a plain indexed column instead of a per-request aggregate —
  // docs/models/artifact.md §4 lists this as "derived", logged here as the storage deviation.
  lastAccessedAt DateTime?

  owner         User                   @relation("owner", fields: [ownerId], references: [id])
  allowedUsers  ArtifactAllowedUser[]
  allowedGroups ArtifactAllowedGroup[]
  tags          ArtifactTag[]
  comments      Comment[]
  shareLinks    ShareLink[]
  relFrom       ArtifactRelationship[]  @relation("from")
  relTo         ArtifactRelationship[]  @relation("to")
  accessEvents  AccessEvent[]
  enrichments   ArtifactEnrichment[]

  @@index([ownerId, createdAt])
  @@index([audienceType])
  @@index([expiresAt])
  @@index([kind])
  @@index([sourceTool])
  @@index([contentType])
  @@index([lastAccessedAt])
}

model ArtifactAllowedUser {
  artifactId String
  userId     String

  artifact Artifact @relation(fields: [artifactId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@id([artifactId, userId])
  @@index([userId]) // "shared directly with me"
}

model ArtifactAllowedGroup {
  artifactId String
  groupId    String

  artifact Artifact @relation(fields: [artifactId], references: [id])
  group    Group    @relation(fields: [groupId], references: [id])

  @@id([artifactId, groupId])
  @@index([groupId]) // "shared with my group"
}

model Tag {
  id   String @id @default(uuid())
  name String @unique

  artifacts ArtifactTag[]
}

model ArtifactTag {
  artifactId String
  tagId      String

  // Provenance — every row before this migration is a human-entered tag (backfilled `human`);
  // `confidence` is only ever set for `source = ai` rows (the enrichment job's own score).
  source     EnrichmentSource @default(human)
  confidence Float?
  createdAt  DateTime         @default(now())

  artifact Artifact @relation(fields: [artifactId], references: [id])
  tag      Tag      @relation(fields: [tagId], references: [id])

  @@id([artifactId, tagId])
  @@index([tagId])
}

model Comment {
  id         String   @id @default(uuid())
  artifactId String
  authorId   String
  body       String
  createdAt  DateTime @default(now())

  artifact Artifact @relation(fields: [artifactId], references: [id])
  author   User     @relation(fields: [authorId], references: [id])

  @@index([artifactId, createdAt])
}

// Pure locator — carries NO access policy. Redemption re-runs canView vs the artifact's policy.
model ShareLink {
  id          String   @id @default(uuid())
  artifactId  String
  tokenHash   String   @unique // sha-256 of /s/<token>
  createdById String
  revoked     Boolean  @default(false) // optional single-link retire; policy stays authoritative
  createdAt   DateTime @default(now())

  artifact     Artifact      @relation(fields: [artifactId], references: [id])
  createdBy    User          @relation(fields: [createdById], references: [id])
  accessEvents AccessEvent[]
}

// Enables UI/agent navigation between related artifacts (e.g. "this is a compiled version of …").
model ArtifactRelationship {
  id          String       @id @default(uuid())
  fromId      String
  toId        String
  type        RelationType
  note        String? // short free-text label, e.g. "post-processed export"
  createdById String
  createdAt   DateTime     @default(now())

  // Provenance — `createdById` stays the acting human/owner even for `source = ai` rows (no
  // system-actor concept in this schema); `confidence` is the enrichment job's own score,
  // only ever set for `source = ai` rows.
  source     EnrichmentSource @default(human)
  confidence Float?

  from      Artifact @relation("from", fields: [fromId], references: [id])
  to        Artifact @relation("to", fields: [toId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@unique([fromId, toId, type])
}

// One row per enrichment run (append-only — a rerun doesn't erase the previous attempt).
// The queryable status/result record surfaced to the SPA (polling + rerun) and the
// `get_enrichment_status` MCP tool; the actual side effects (tags, relationships, summary) land
// on Artifact/ArtifactTag/ArtifactRelationship, this is the job's own audit trail.
model ArtifactEnrichment {
  id                    String           @id @default(uuid())
  artifactId            String
  status                EnrichmentStatus @default(pending)
  trigger               String // "publish" | "rerun"
  requestedById         String
  startedAt             DateTime?
  completedAt           DateTime?
  error                 String?
  summary               String?
  topics                String[]         @default([])
  tagsAdded             String[]         @default([])
  relationshipsProposed Json             @default("[]") // [{ toId, type, confidence, accepted }]
  createdAt             DateTime         @default(now())

  artifact    Artifact @relation(fields: [artifactId], references: [id])
  requestedBy User     @relation(fields: [requestedById], references: [id])

  @@index([artifactId, createdAt])
}

// ─────────────────────────── audit & system ───────────────────────────

// Artifact ACCESS audit trail (view/download via ui | share_link | mcp; allowed AND denied).
model AccessEvent {
  id          String         @id @default(uuid())
  artifactId  String
  userId      String // always set — no anonymous access
  route       AccessRoute
  action      AccessAction
  shareLinkId String? // set when route = share_link
  decision    AccessDecision
  denyReason  String? // e.g. "expired", "not_in_audience"
  clientInfo  Json           @default("{}") // non-PII: client name/version, coarse UA
  at          DateTime       @default(now())

  artifact  Artifact   @relation(fields: [artifactId], references: [id])
  user      User       @relation(fields: [userId], references: [id])
  shareLink ShareLink? @relation(fields: [shareLinkId], references: [id])

  @@index([artifactId, at])
  @@index([userId, at])
  @@index([route])
}

// Administrative actions (invite / role.change / policy.update / …) — NOT artifact reads.
model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String? // null for system/seed
  action     String
  targetType String
  targetId   String
  metadata   Json     @default("{}") // e.g. { before, after }
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}

// Transactional outbox — reliable external side-effects (Resend email, Auth0 provisioning).
model OutboxEvent {
  id             String    @id @default(uuid())
  type           String // e.g. "invitation.send"
  payload        Json
  status         String    @default("pending") // pending | done | failed
  attempts       Int       @default(0)
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())
  processedAt    DateTime?
}
