# Copy to .env (git-ignored). Vite only exposes vars prefixed with VITE_ (all are public, no secrets).
# Dev: local backend. Prod: the Fly backend URL, set as a Netlify build env var (not committed) —
#   e.g. VITE_API_BASE_URL="https://artifact-hub-backend.fly.dev/api"
VITE_API_BASE_URL="http://localhost:3081/api"

# Auth0 (Role A — passwordless magic link; see docs/architecture/02)
VITE_AUTH0_DOMAIN="your-tenant.eu.auth0.com"
VITE_AUTH0_CLIENT_ID="your-spa-client-id"
VITE_AUTH0_AUDIENCE="https://api.artifact-hub.example"
