# Copy to .env (git-ignored). Vite only exposes vars prefixed with VITE_.
VITE_API_BASE_URL="http://localhost:3000/api"

# Auth0 (Role A — passwordless magic link; see docs/architecture/02)
VITE_AUTH0_DOMAIN="your-tenant.eu.auth0.com"
VITE_AUTH0_CLIENT_ID="your-spa-client-id"
VITE_AUTH0_AUDIENCE="https://api.artifact-hub.example"
