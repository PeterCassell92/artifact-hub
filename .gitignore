# ── Dependencies ──────────────────────────────────────────────
node_modules/
**/node_modules/
.pnp.*                # (PnP not used — nodeLinker: node-modules — but ignored just in case)

# ── Yarn (Berry, node-modules linker) ─────────────────────────
# Keep committed: releases, plugins, patches, sdks, versions; ignore the cache/state.
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.yarn/cache
.yarn/install-state.gz

# ── Environment / secrets — NEVER commit ──────────────────────
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
# .env.test files hold only dummy/non-secret values for CI/Jest — safe + necessary to commit.
!**/.env.test

# ── Build output ──────────────────────────────────────────────
dist/
build/
out/
**/dist/
**/build/
*.tsbuildinfo
apps/frontend/.vite/
.next/

# ── Test / coverage ───────────────────────────────────────────
coverage/
**/coverage/
.nyc_output/

# ── Prisma ────────────────────────────────────────────────────
# Generated client (regenerated via `prisma generate`); migrations ARE committed.
apps/backend/src/generated/
**/prisma/*.db
**/prisma/*.db-journal

# ── Terraform ─────────────────────────────────────────────────
.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars           # may contain secrets; commit a *.tfvars.example instead
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
.terraform.lock.hcl

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Editor / OS ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
# Keep repo-level VS Code sharing but ignore personal cruft:
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ── Local scratch — root /tmp (not committed) ─────────────────
# The folder itself is kept (via .gitkeep); everything you drop inside is ignored.
/tmp/*
!/tmp/.gitkeep

# ── Misc caches ───────────────────────────────────────────────
.cache/
.eslintcache

# Firecrawl scrape cache (web research)
.firecrawl/
.playwright-mcp/
