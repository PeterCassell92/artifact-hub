# Root dev env — docker compose auto-loads this (the ${VARS} in docker-compose.yml).
# Copy to .env (git-ignored) and set POSTGRES_PASSWORD before `docker compose up -d`.
#
# These are LOCAL DEV values only. Real runtime secrets (prod RDS password, Auth0 client
# secret + Management API creds, SES) live in AWS Secrets Manager and are injected into the
# ECS task — never committed, never GitHub Secrets. See docs/architecture/07 §"Secrets".

# Throwaway local-dev credentials — fine as a committed default (the real .env is git-ignored).
POSTGRES_USER=artifacthub
POSTGRES_PASSWORD=artifacthub
POSTGRES_DB=artifacthub

# apps/backend/.env's DATABASE_URL encodes these same creds — keep its password in sync with
# POSTGRES_PASSWORD above (default already matches). The backend does NOT need separate POSTGRES_*
# vars; Prisma reads only DATABASE_URL.
