# Root dev env — docker compose auto-loads this (the ${VARS} in docker-compose.yml).
# Copy to .env (git-ignored) and set POSTGRES_PASSWORD before `docker compose up -d`.
#
# These are LOCAL DEV values only. Real runtime secrets (prod Postgres password, Auth0 client
# secret, Resend API key, Tigris keys) live in `fly secrets` and are injected into the Fly
# machine — never committed, never GitHub Secrets. See docs/architecture/07.

# Throwaway local-dev credentials — fine as a committed default (the real .env is git-ignored).
POSTGRES_USER=artifacthub
POSTGRES_PASSWORD=artifacthub
POSTGRES_DB=artifacthub

# apps/backend/.env's DATABASE_URL encodes these same creds — keep its password in sync with
# POSTGRES_PASSWORD above (default already matches), and note DATABASE_URL uses host port 5440.
# The backend does NOT need separate POSTGRES_* vars; Prisma reads only DATABASE_URL.

# ── Object storage (MinIO, local Tigris stand-in) ──
# docker-compose's minio + createbuckets services read these. They mirror apps/backend/.env's
# AWS_* + BUCKET_NAME (the backend's S3 client); defaults below match, override here if you change
# them. Console: http://localhost:9001
AWS_ACCESS_KEY_ID=dev-access-key
AWS_SECRET_ACCESS_KEY=dev-secret-key
BUCKET_NAME=artifact-hub-dev
