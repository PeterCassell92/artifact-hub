meta {
  name: Mint MCP Token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/test/mcp-token
  body: json
  auth: none
}

headers {
  X-Test-Token: {{testMintSecret}}
}

body:json {
  { "email": "{{devUser}}" }
}

script:post-response {
  bru.setEnvVar("mcpToken", res.body.access_token);
}

assert {
  res.status: eq 200
}
